# Normalize line endings so Windows working copies and CI agree.
* text=auto

# Dataverse solution source is generated by pac. Leaving it unconverted keeps a re-export
# from churning the whole tree on line endings alone, which would bury real schema diffs.
solutions/** -text
legacy/** -text

*.zip binary

# Squad: union merge for append-only team state files
.squad/decisions.md merge=union
.squad/agents/*/history.md merge=union
.squad/log/** merge=union
.squad/orchestration-log/** merge=union
.squad/rai/audit-trail.md merge=union
.squad/fact-checker/audit-trail.md merge=union
