# Solution export artifacts — never commit; they contain packed binaries and
# historically have contained flow trigger secrets. Commit unpacked source only.
artifacts/
*.zip

# Local deployment settings that may carry environment-specific identifiers
deployment/settings/*.local.json

# Tooling
bin/
obj/
.vs/
*.user
node_modules/

# OS
Thumbs.db
.DS_Store
# Squad: ignore runtime state (logs, inbox, sessions)
# Note: .squad/casting/* is identity and MUST be committed to main, not ignored
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
.squad/.cache/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream
.ai_local/
